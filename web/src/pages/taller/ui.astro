---
// taller/ui.astro — editor visual de la UI de la app Vita (docs/07 §2,
// desbloqueado por ADR 0005): edita vita-app/ui/layout.json con preview 2D
// aproximada (la emulación real se descartó — web/README.md), lo aplica al
// repo (codegen ui_layout.h + check en host) y recompila/despliega el .vpk
// con los endpoints del taller que ya existían.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { tallerActivo } from '../../lib/taller';

const activo = tallerActivo();
---

<Base
  title="Editor de UI de la app"
  description="Editor visual de la UI declarativa de vita-ros2-hello: widgets sobre una pantalla 960×544, preview 2D, y aplicar + compilar + deploy desde la web."
>
  <p><a href="/taller">← Taller</a></p>
  <h1>Editor de UI de la app</h1>
  <p class="nota" style="max-width:70ch">
    La UI de la app es <strong>declarativa</strong>: este editor produce
    <code>vita-app/ui/layout.json</code>, el codegen lo convierte en
    <code>ui_layout.h</code> y la app lo dibuja con vita2d. La preview es una
    aproximación 2D (fuente y métricas del navegador), no una emulación.
    El borrador se guarda solo; nada toca el repo hasta «Aplicar al proyecto».
  </p>

  {!activo && (
    <div class="panel" style="border-color: rgba(251,191,36,.4); margin-bottom:1rem">
      <strong style="color:var(--warn)">Taller desactivado:</strong>
      <span style="color:var(--text-dim)"> puedes editar y guardar borrador, pero «Aplicar», «Compilar» y «Deploy» devolverán 403. Arranca con <code>TALLER_ENABLED=1</code> en el PC de desarrollo.</span>
    </div>
  )}

  <div class="editor-grid">
    <section class="panel lateral">
      <h2 style="margin-top:0">Widgets</h2>
      <div class="paleta">
        <button class="btn ghost" id="add-panel" type="button">+ panel</button>
        <button class="btn ghost" id="add-label" type="button">+ label</button>
        <button class="btn ghost" id="add-valor" type="button">+ valor</button>
      </div>

      <h2>Propiedades</h2>
      <div id="props" class="props">
        <p class="nota" id="props-vacio">Selecciona un widget en la pantalla (o añade uno).</p>
        <div id="props-form" hidden>
          <div class="fila-xy">
            <label class="campo"><span>x</span><input id="p-x" type="number" min="0" max="959" /></label>
            <label class="campo"><span>y</span><input id="p-y" type="number" min="0" max="543" /></label>
            <label class="campo solo-panel"><span>w</span><input id="p-w" type="number" min="1" max="960" /></label>
            <label class="campo solo-panel"><span>h</span><input id="p-h" type="number" min="1" max="544" /></label>
          </div>
          <label class="campo"><span>color</span><input id="p-color" type="color" /></label>
          <label class="campo solo-panel"><span>borde (vacío = sin borde)</span>
            <div class="fila-xy">
              <input id="p-borde" type="color" />
              <label class="nota" style="display:flex;align-items:center;gap:.3rem">
                <input id="p-con-borde" type="checkbox" /> con borde
              </label>
            </div>
          </label>
          <label class="campo solo-texto"><span>escala (0.5 – 3.0)</span>
            <input id="p-escala" type="number" min="0.5" max="3" step="0.1" />
          </label>
          <label class="campo solo-label"><span>texto (ASCII, máx. 63)</span>
            <input id="p-texto" maxlength="63" />
          </label>
          <label class="campo solo-valor"><span>binding (dato de la app)</span>
            <select id="p-binding">
              <option value="estado_conexion">estado_conexion</option>
              <option value="contador_publicados">contador_publicados</option>
              <option value="ultimo_pc_hello">ultimo_pc_hello</option>
              <option value="agente">agente</option>
              <option value="vel_lineal">vel_lineal</option>
              <option value="vel_lateral">vel_lateral</option>
              <option value="cmd_vel">cmd_vel</option>
              <option value="contador_cmd">contador_cmd</option>
            </select>
          </label>
          <button class="btn ghost" id="p-eliminar" type="button">Eliminar widget</button>
        </div>
      </div>

      <h2>Acciones</h2>
      <div class="acciones">
        <button class="btn ghost" id="btn-repo" type="button">Cargar el del repo</button>
        <button class="btn" id="btn-aplicar" type="button">Aplicar al proyecto</button>
        <div class="fila-xy">
          <select id="a-variante"><option value="rust">rust</option><option value="c">c</option></select>
          <button class="btn ghost" id="btn-compilar" type="button">Compilar</button>
        </div>
        <div class="fila-xy">
          <input id="a-ip" placeholder="IP Vita (FTP)" pattern="^(\d{1,3}\.){3}\d{1,3}$" />
          <button class="btn ghost" id="btn-deploy" type="button">Deploy</button>
        </div>
        <p class="nota" id="estado-borrador">—</p>
      </div>
    </section>

    <section class="derecha">
      <div class="panel" style="padding:.7rem">
        <canvas id="lienzo" width="960" height="544"></canvas>
      </div>
      <section class="panel">
        <h2 style="margin-top:0">Salida</h2>
        <pre class="consola" id="consola">— sin actividad —</pre>
      </section>
    </section>
  </div>

  <style>
    .editor-grid { display: grid; grid-template-columns: 300px 1fr; gap: 1rem; align-items: start; }
    @media (max-width: 980px) { .editor-grid { grid-template-columns: 1fr; } }
    .derecha { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
    #lienzo {
      width: 100%; height: auto; display: block; border-radius: 6px;
      cursor: crosshair; touch-action: none;
      background: #000; /* se repinta entero en cada draw */
    }
    .paleta, .acciones { display: flex; flex-direction: column; gap: .5rem; }
    .paleta { flex-direction: row; flex-wrap: wrap; }
    .fila-xy { display: flex; gap: .5rem; align-items: end; }
    .fila-xy .campo { flex: 1; margin-bottom: 0; }
    .campo { display: block; margin-bottom: .8rem; }
    .campo span { display: block; font-size: .8rem; color: var(--text-dim); margin-bottom: .25rem; }
    .campo input, .campo select, .acciones input, .acciones select {
      width: 100%; background: var(--bg-soft); color: var(--text);
      border: 1px solid var(--panel-border); border-radius: 8px; padding: .45rem .6rem;
      font-family: var(--mono); font-size: .85rem;
    }
    .campo input[type='color'] { padding: .15rem; height: 2.2rem; }
    .campo input[type='checkbox'] { width: auto; }
    .consola {
      background: #05080f; border: 1px solid var(--panel-border); border-radius: 8px;
      padding: .7rem .8rem; height: 220px; overflow: auto;
      font-family: var(--mono); font-size: .74rem; line-height: 1.45;
      white-space: pre-wrap; word-break: break-all;
    }
    .consola :global(.err) { color: var(--hw); }
    .consola :global(.fin-ok) { color: var(--ok); font-weight: 700; }
    .nota { font-size: .78rem; color: var(--text-dim); }
  </style>

  <script>
    import { obtenerClientId } from '../../lib/client-id';
    import { lanzarJob } from '../../lib/taller-client';
    import {
      UI_PANTALLA_W,
      UI_PANTALLA_H,
      type UiLayout,
      type UiWidget,
    } from '../../lib/ui-layout';

    // ---------- estado ----------
    let layout: UiLayout = { version: 1, fondo: '#101018', widgets: [] };
    let sel = -1; // índice del widget seleccionado

    const clientId = obtenerClientId();
    const $ = (id: string) => document.getElementById(id)!;
    const lienzo = $('lienzo') as HTMLCanvasElement;
    const ctx = lienzo.getContext('2d')!;
    const consola = $('consola');

    // Valores de ejemplo para la preview de los `valor` (en la Vita salen
    // del ui_state real; ver vita-app/src/ui.c).
    const EJEMPLOS: Record<string, string> = {
      estado_conexion: 'CONECTADO',
      contador_publicados: '1234',
      ultimo_pc_hello: 'hola desde el PC',
      agente: '192.168.1.108:8888',
      vel_lineal: '0.5 m/s',
      vel_lateral: '0.5 m/s',
      cmd_vel: 'x+0.50 y+0.00 rz-0.50',
      contador_cmd: '2048',
    };

    // ---------- preview (aproximación 2D del dibujado de ui.c) ----------
    const textoDe = (w: UiWidget) => (w.tipo === 'label' ? (w.texto ?? '') : (EJEMPLOS[w.binding ?? ''] ?? '?'));
    // La PGF por defecto a escala 1 mide ~20 px; misma base que usa ui.c.
    const fuenteDe = (w: UiWidget) => `${Math.round(20 * (w.escala ?? 1))}px sans-serif`;

    // Caja de un widget en coordenadas de pantalla (para clic y selección).
    function caja(w: UiWidget): { x: number; y: number; w: number; h: number } {
      if (w.tipo === 'panel') return { x: w.x, y: w.y, w: w.w ?? 1, h: w.h ?? 1 };
      ctx.font = fuenteDe(w);
      const alto = Math.round(20 * (w.escala ?? 1) * 1.15);
      return { x: w.x, y: w.y, w: Math.max(24, ctx.measureText(textoDe(w)).width), h: alto };
    }

    function dibujar() {
      ctx.fillStyle = layout.fondo;
      ctx.fillRect(0, 0, UI_PANTALLA_W, UI_PANTALLA_H);
      for (const w of layout.widgets) {
        if (w.tipo === 'panel') {
          ctx.fillStyle = w.color;
          ctx.fillRect(w.x, w.y, w.w ?? 1, w.h ?? 1);
          if (w.borde) {
            ctx.strokeStyle = w.borde;
            ctx.lineWidth = 2;
            ctx.strokeRect(w.x + 1, w.y + 1, (w.w ?? 1) - 2, (w.h ?? 1) - 2);
          }
        } else {
          ctx.font = fuenteDe(w);
          ctx.textBaseline = 'top';
          ctx.fillStyle = w.color;
          ctx.fillText(textoDe(w), w.x, w.y);
        }
      }
      if (sel >= 0 && layout.widgets[sel]) {
        const c = caja(layout.widgets[sel]);
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 4]);
        ctx.strokeRect(c.x - 3, c.y - 3, c.w + 6, c.h + 6);
        ctx.setLineDash([]);
      }
    }

    // ---------- borrador (autosave, patrón del dashboard) ----------
    const estadoBorrador = $('estado-borrador');
    let timerGuardar: ReturnType<typeof setTimeout> | undefined;
    function guardarBorrador() {
      clearTimeout(timerGuardar);
      timerGuardar = setTimeout(async () => {
        if (!layout.widgets.length) return; // el schema exige >= 1 widget
        try {
          const res = await fetch('/api/taller/ui/borrador', {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-client-id': clientId },
            body: JSON.stringify({ layout }),
          });
          const datos = await res.json().catch(() => ({}));
          estadoBorrador.textContent = res.ok
            ? `Borrador guardado (${new Date().toLocaleTimeString()})`
            : `Borrador NO guardado: ${datos.error ?? res.statusText}`;
        } catch {
          estadoBorrador.textContent = 'Borrador NO guardado: backend caído';
        }
      }, 700);
    }

    function cambiado() {
      dibujar();
      guardarBorrador();
    }

    // ---------- propiedades ----------
    const form = $('props-form');
    const vacio = $('props-vacio');
    const campos = {
      x: $('p-x') as HTMLInputElement,
      y: $('p-y') as HTMLInputElement,
      w: $('p-w') as HTMLInputElement,
      h: $('p-h') as HTMLInputElement,
      color: $('p-color') as HTMLInputElement,
      borde: $('p-borde') as HTMLInputElement,
      conBorde: $('p-con-borde') as HTMLInputElement,
      escala: $('p-escala') as HTMLInputElement,
      texto: $('p-texto') as HTMLInputElement,
      binding: $('p-binding') as HTMLSelectElement,
    };

    function refrescarProps() {
      const w = layout.widgets[sel];
      form.hidden = !w;
      vacio.hidden = !!w;
      if (!w) return;
      form.querySelectorAll<HTMLElement>('.solo-panel').forEach((e) => (e.hidden = w.tipo !== 'panel'));
      form.querySelectorAll<HTMLElement>('.solo-texto').forEach((e) => (e.hidden = w.tipo === 'panel'));
      form.querySelectorAll<HTMLElement>('.solo-label').forEach((e) => (e.hidden = w.tipo !== 'label'));
      form.querySelectorAll<HTMLElement>('.solo-valor').forEach((e) => (e.hidden = w.tipo !== 'valor'));
      campos.x.value = String(w.x);
      campos.y.value = String(w.y);
      campos.w.value = String(w.w ?? '');
      campos.h.value = String(w.h ?? '');
      campos.color.value = w.color;
      campos.conBorde.checked = !!w.borde;
      campos.borde.value = w.borde ?? '#3b82f6';
      campos.escala.value = String(w.escala ?? 1);
      campos.texto.value = w.texto ?? '';
      campos.binding.value = w.binding ?? 'estado_conexion';
    }

    function leerProps() {
      const w = layout.widgets[sel];
      if (!w) return;
      const ent = (v: string, min: number, max: number, def: number) => {
        const n = Math.round(Number(v));
        return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : def;
      };
      w.x = ent(campos.x.value, 0, UI_PANTALLA_W - 1, w.x);
      w.y = ent(campos.y.value, 0, UI_PANTALLA_H - 1, w.y);
      if (w.tipo === 'panel') {
        w.w = ent(campos.w.value, 1, UI_PANTALLA_W - w.x, w.w ?? 1);
        w.h = ent(campos.h.value, 1, UI_PANTALLA_H - w.y, w.h ?? 1);
        if (campos.conBorde.checked) w.borde = campos.borde.value;
        else delete w.borde;
      } else {
        const e = Number(campos.escala.value);
        w.escala = Number.isFinite(e) ? Math.min(3, Math.max(0.5, e)) : (w.escala ?? 1);
        if (w.tipo === 'label') {
          // Solo ASCII imprimible: mismo filtro que el codegen/backend.
          const t = campos.texto.value.replace(/[^\x20-\x7e]/g, '').slice(0, 63);
          if (t) w.texto = t;
        } else {
          w.binding = campos.binding.value as UiWidget['binding'];
        }
      }
      cambiado();
    }
    for (const el of Object.values(campos)) el.addEventListener('input', leerProps);
    $('p-eliminar').addEventListener('click', () => {
      if (sel < 0) return;
      layout.widgets.splice(sel, 1);
      sel = -1;
      refrescarProps();
      cambiado();
    });

    // ---------- paleta ----------
    const PLANTILLAS: Record<string, UiWidget> = {
      panel: { tipo: 'panel', x: 40, y: 40, w: 240, h: 96, color: '#161d2b', borde: '#2a3650' },
      label: { tipo: 'label', x: 48, y: 48, texto: 'texto', color: '#e2e8f0', escala: 1.0 },
      valor: { tipo: 'valor', x: 48, y: 80, binding: 'estado_conexion', color: '#4ade80', escala: 1.0 },
    };
    for (const tipo of ['panel', 'label', 'valor'] as const) {
      $(`add-${tipo}`).addEventListener('click', () => {
        if (layout.widgets.length >= 32) {
          estadoBorrador.textContent = 'Máximo 32 widgets.';
          return;
        }
        layout.widgets.push(structuredClone(PLANTILLAS[tipo]));
        sel = layout.widgets.length - 1;
        refrescarProps();
        cambiado();
      });
    }

    // ---------- selección y arrastre sobre el canvas ----------
    let arrastre: { dx: number; dy: number } | null = null;
    const SNAP = 8;

    function puntoLienzo(ev: PointerEvent): { x: number; y: number } {
      const r = lienzo.getBoundingClientRect();
      return {
        x: ((ev.clientX - r.left) * UI_PANTALLA_W) / r.width,
        y: ((ev.clientY - r.top) * UI_PANTALLA_H) / r.height,
      };
    }

    lienzo.addEventListener('pointerdown', (ev) => {
      const p = puntoLienzo(ev);
      sel = -1;
      // El último de la lista se dibuja encima: buscar de atrás hacia delante.
      for (let i = layout.widgets.length - 1; i >= 0; i--) {
        const c = caja(layout.widgets[i]);
        if (p.x >= c.x && p.x <= c.x + c.w && p.y >= c.y && p.y <= c.y + c.h) {
          sel = i;
          arrastre = { dx: p.x - c.x, dy: p.y - c.y };
          lienzo.setPointerCapture(ev.pointerId);
          break;
        }
      }
      refrescarProps();
      dibujar();
    });
    lienzo.addEventListener('pointermove', (ev) => {
      if (!arrastre || sel < 0) return;
      const w = layout.widgets[sel];
      const p = puntoLienzo(ev);
      const maxX = UI_PANTALLA_W - (w.tipo === 'panel' ? (w.w ?? 1) : 1);
      const maxY = UI_PANTALLA_H - (w.tipo === 'panel' ? (w.h ?? 1) : 1);
      w.x = Math.min(maxX, Math.max(0, Math.round((p.x - arrastre.dx) / SNAP) * SNAP));
      w.y = Math.min(maxY, Math.max(0, Math.round((p.y - arrastre.dy) / SNAP) * SNAP));
      refrescarProps();
      dibujar();
    });
    lienzo.addEventListener('pointerup', () => {
      if (arrastre) guardarBorrador();
      arrastre = null;
    });

    // ---------- acciones ----------
    async function cargarDelRepo() {
      const res = await fetch('/api/taller/ui/layout');
      const datos = await res.json().catch(() => ({}));
      if (!res.ok || !datos.layout) {
        estadoBorrador.textContent = `No se pudo cargar del repo: ${datos.error ?? res.statusText}`;
        return false;
      }
      layout = datos.layout;
      sel = -1;
      refrescarProps();
      cambiado();
      return true;
    }
    $('btn-repo').addEventListener('click', cargarDelRepo);
    $('btn-aplicar').addEventListener('click', () => lanzarJob('/api/taller/ui/aplicar', { layout }, consola));
    $('btn-compilar').addEventListener('click', () =>
      lanzarJob('/api/taller/build', { variante: ($('a-variante') as HTMLSelectElement).value }, consola),
    );
    $('btn-deploy').addEventListener('click', () =>
      lanzarJob(
        '/api/taller/deploy',
        { variante: ($('a-variante') as HTMLSelectElement).value, ip: ($('a-ip') as HTMLInputElement).value },
        consola,
      ),
    );

    // ---------- arranque: borrador guardado o, si no hay, el del repo ----------
    (async () => {
      try {
        const res = await fetch('/api/taller/ui/borrador', { headers: { 'x-client-id': clientId } });
        const datos = await res.json().catch(() => ({}));
        if (res.ok && datos.layout) {
          layout = datos.layout;
          estadoBorrador.textContent = 'Borrador recuperado.';
          dibujar();
          return;
        }
      } catch {
        /* backend caído: se intenta el repo igualmente */
      }
      if (!(await cargarDelRepo())) dibujar();
    })();
  </script>
</Base>
