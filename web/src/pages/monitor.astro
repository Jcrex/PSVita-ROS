---
// monitor.astro — dashboard en vivo del netlog de la Vita. Ver
// docs/superpowers/specs/2026-07-01-dashboard-logs-vita-design.md.
export const prerender = false;
import Base from '../layouts/Base.astro';
import { listSessions, getSessionLines } from '../lib/db';

const sessions = listSessions();
const latest = sessions[0];
const initialLines = latest ? getSessionLines(latest.id) : [];

const statusLabel: Record<string, string> = {
  'en-curso': '🟢 viva',
  establecida: '✅ establecida',
  fatal: '🔴 fatal',
  cerrada: '⚪ cerrada',
};

function lineClass(kind: string) {
  if (kind === 'fatal') return 'log-fatal';
  if (kind === 'hito') return 'log-hito';
  return '';
}
---

<Base title="Monitor" description="Logs en vivo de la PS Vita, por sesión.">
  <h1>Monitor de la Vita <span id="global-status">⚪</span></h1>
  <p style="color:var(--text-dim)">
    Sustituye la lectura manual con <code>tools/netlog-listen.sh</code>:
    cada lanzamiento de <code>vita-ros2-hello</code> queda aquí como una
    sesión navegable.
  </p>

  {sessions.length === 0 && (
    <p>Todavía no ha llegado ningún log de la Vita.</p>
  )}

  <div class="monitor-grid">
    <aside class="panel" id="session-list">
      <h2 style="margin-top:0;border:none">Sesiones</h2>
      <ul id="sessions-ul" style="list-style:none;padding:0">
        {sessions.map((s) => (
          <li>
            <button class="session-btn" data-id={s.id}>
              #{s.id} — {s.started_at}{' '}
              <span class="badge">{statusLabel[s.status]}</span>
            </button>
          </li>
        ))}
      </ul>
    </aside>

    <section
      class="panel"
      id="log-panel"
      data-session-id={latest?.id ?? ''}
      data-last-line-id={initialLines.at(-1)?.id ?? 0}
    >
      <h2 style="margin-top:0;border:none" id="log-title">
        {latest ? `Sesión #${latest.id}` : 'Sin sesiones todavía'}
      </h2>
      {/* Nota: se usa concatenación con '+' en vez de un template literal
          porque el compilador de Astro falla al parsear un contenedor de
          expresión JSX que sea (o termine en) un `'\n'` literal aislado o
          dentro de un template string aquí — error reproducido y acotado
          a mano; la concatenación produce el mismo texto y evita el bug. */}
      <pre id="log-lines">{initialLines.map((l) => (
        <span class={lineClass(l.kind)}>{'[' + l.received_at + '] ' + l.raw_text + '\n'}</span>
      ))}</pre>
    </section>
  </div>

  <style>
    .monitor-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 1.2rem;
      align-items: start;
    }
    .session-btn {
      display: block;
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      color: var(--text);
      padding: .4rem .3rem;
      cursor: pointer;
      font: inherit;
      border-radius: 6px;
    }
    .session-btn:hover { background: var(--panel-border); }
    #log-lines {
      max-height: 60vh;
      overflow-y: auto;
      background: var(--bg-soft);
      padding: 1rem;
      border-radius: var(--radius);
      font-family: var(--mono);
      font-size: .85rem;
      white-space: pre-wrap;
    }
    .log-fatal { color: #f87171; }
    .log-hito { color: var(--ok); font-weight: 600; }
  </style>

  <script>
    interface LogLine {
      id: number;
      session_id: number;
      received_at: string;
      raw_text: string;
      kind: 'normal' | 'hito' | 'fatal';
    }

    const logLines = document.getElementById('log-lines')!;
    const logTitle = document.getElementById('log-title')!;
    const logPanel = document.getElementById('log-panel')!;
    const globalStatus = document.getElementById('global-status')!;

    // Autoscroll inicial: el historial renderizado por el servidor puede
    // superar los 60vh visibles; sin esto la página abriría con el scroll
    // arriba en vez de mostrar las líneas más recientes.
    logLines.scrollTop = logLines.scrollHeight;

    // Sesión que el cliente ya considera "en vivo": se siembra desde el
    // dato ya renderizado por el servidor, para no confundir la
    // sincronización inicial del EventSource con una transición real.
    let currentLiveSessionId: number | null = logPanel.dataset.sessionId
      ? Number(logPanel.dataset.sessionId)
      : null;

    // Marca de agua: id de línea más alto ya renderizado. Sirve para
    // descartar el reenvío completo del historial que el SSE hace en cada
    // conexión/reconexión (ver stream.ts), evitando líneas duplicadas.
    let lastRenderedLineId = Number(logPanel.dataset.lastLineId ?? 0);

    function lineNode(l: { received_at: string; raw_text: string; kind: string }) {
      const span = document.createElement('span');
      span.className =
        l.kind === 'fatal' ? 'log-fatal' : l.kind === 'hito' ? 'log-hito' : '';
      span.textContent = `[${l.received_at}] ${l.raw_text}\n`;
      return span;
    }

    async function loadSession(id: string) {
      const res = await fetch(`/api/monitor/session/${id}`);
      if (!res.ok) return;
      const { session, lines } = await res.json();
      logTitle.textContent = `Sesión #${session.id}`;
      logPanel.dataset.sessionId = String(session.id);
      logLines.innerHTML = '';
      for (const l of lines) logLines.appendChild(lineNode(l));
      logLines.scrollTop = logLines.scrollHeight;
      if (lines.length > 0) {
        lastRenderedLineId = Math.max(...lines.map((l: LogLine) => l.id));
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.session-btn').forEach((btn) => {
      btn.addEventListener('click', () => loadSession(btn.dataset.id!));
    });

    // Vista en vivo: sigue siempre la sesión más reciente vía SSE.
    const source = new EventSource('/api/monitor/stream');
    source.addEventListener('session-changed', (ev) => {
      const { sessionId } = JSON.parse((ev as MessageEvent).data) as { sessionId: number };
      if (sessionId !== currentLiveSessionId) {
        location.reload();
        return;
      }
    });
    source.onmessage = (ev) => {
      const line: LogLine = JSON.parse(ev.data);
      if (line.id <= lastRenderedLineId) return;
      if (logPanel.dataset.sessionId === String(line.session_id)) {
        logLines.appendChild(lineNode(line));
        logLines.scrollTop = logLines.scrollHeight;
      }
      lastRenderedLineId = line.id;
    };

    // Indicador global: ¿llegó algo en los últimos 5s?
    async function pollStatus() {
      const res = await fetch('/api/monitor/status');
      const { lastReceivedAt } = (await res.json()) as { lastReceivedAt: string | null };
      const fresh =
        !!lastReceivedAt &&
        Date.now() - new Date(lastReceivedAt.replace(' ', 'T') + 'Z').getTime() < 5000;
      globalStatus.textContent = fresh ? '🟢' : '⚪';
      setTimeout(pollStatus, 5000);
    }
    pollStatus();
  </script>
</Base>
