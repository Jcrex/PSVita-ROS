; Proyecto de la puerta G6 (docs/18 §8): HMI piloto — teleop /cmd_vel con los mandos de la Vita y vista
; cenital de /odom (rejilla, robot y rastro). Probar con docker/vita-ros.sh sim (turtlesim) o sim-tb3.
; El agente micro-ROS corre en el PC (192.168.1.65): docker run --net=host microros/micro-ros-agent:jazzy udp4 --port 8888
; Se exporta con tools/export-vita-vpk.sh godot/g6-hmi.
config_version=5

[application]

config/name="ros2_vita G6 hmi"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=544

[editor_plugins]

enabled=PackedStringArray("res://addons/psvita/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[ros]

schema_path="res://ros/schema.rsch"
agent_ip="192.168.1.65"
agent_port=8888
domain_id=0

[threading]

worker_pool/max_threads=2
