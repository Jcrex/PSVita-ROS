# Variables de entorno esperadas (las exporta tools/build-godot-template.sh):
#   PSVITA_ROS_ROOT : raíz de este repo
#   PSVITA_ROS_LIBS : carpeta con libvita_modules_rust.a o las .a de impl-c
import os

Import("env")
Import("env_modules")

env_ros = env_modules.Clone()

root = os.environ.get("PSVITA_ROS_ROOT", "")
libs = os.environ.get("PSVITA_ROS_LIBS", "")

# Headers C de los módulos duales (contrato único).
for mod in ("msg-ring", "mem-pool", "net-udp", "microros-transport"):
    env_ros.Append(CPPPATH=[os.path.join(root, "modules", mod, "include")])

env_ros.add_source_files(env.modules_sources, "*.cpp")

# Enlazado estático de la capa ROS al ejecutable de Godot.
if libs:
    env.Append(LIBPATH=[libs])
    env.Append(LIBS=["vita_modules_rust"])  # o las .a de la variante C
